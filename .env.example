VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase integration tests (npm run test:integration)
# Use dev Supabase + real student and admin accounts that can log in.
# One KEY=value per line — no comments or "..." on the same line as the value.
INTEGRATION_TEST_STUDENT_EMAIL=demo-alex@example.com
INTEGRATION_TEST_STUDENT_PASSWORD=your-test-password
INTEGRATION_TEST_ADMIN_EMAIL=your-admin@example.com
INTEGRATION_TEST_ADMIN_PASSWORD=your-admin-password

# Calendar subscribe (after supabase/35-calendar-feed.sql):
#   npx supabase login
#   npx supabase functions deploy calendar-feed --project-ref YOUR_PROJECT_REF
# Feed URL uses *.supabase.co — still works when you move the site to a new domain.
